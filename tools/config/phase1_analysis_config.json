{
  "data_separator": ":",
  "directories": {
    "plots_dir": "plots/phase1_vdtn",
    "report_dir": "reports/phase1_vdtn/"
  },
  "enabled_plots": {
    "3d_surface": true,
    "export_csv": true,
    "heatmaps": false,
    "line_plots": true,
    "pairplot": false,
    "violin_plots": false
  },
  "file_patterns": {
    "report_extension": ".txt"
  },
  "filename_structure": {
    "average_files": {
      "grouping_type_position": -1,
      "report_type_position": 0,
      "router_position": 1,
      "value_positions": [
        2
      ]
    },
    "delimiter": "_",
    "raw_files": {
      "positions": {
        "buffer": 4,
        "prefix": 0,
        "report_type": 5,
        "router": 1,
        "seed": 2,
        "ttl": 3
      }
    }
  },
  "grouping_labels": {
    "buffer": "Buffer Size (MB)",
    "default": "Parameter Value",
    "ttl": "TTL (minutes)"
  },
  "metrics": {
    "ignore": [],
    "include": [
      "delivery_prob",
      "overhead_ratio",
      "latency_avg",
      "hopcount_avg",
      "buffertime_avg",
      "critical_delivery_prob",
      "critical_buffer_dropped",
      "unique_critical_lost",
      "critical_ttl_expired",
      "bulk_buffer_dropped",
      "delivered_payload_bytes",
      "max_buffer_occupancy",
      "shield_intervention_rate",
      "shield_early_rate",
      "shield_late_rate",
      "shield_greedy_intervention_rate",
      "shield_greedy_early_rate",
      "shield_greedy_late_rate",
      "rl_avg_reward",
      "rl_avg_cost",
      "dual_lambda_avg",
      "beacon_overhead_bytes",
      "gossip_overhead_bytes",
      "ack_overhead_bytes",
      "control_to_payload_ratio",
      "profile_0_frac",
      "profile_1_frac",
      "profile_2_frac",
      "profile_3_frac",
      "profile_4_frac",
      "profile_5_frac",
      "profile_6_frac",
      "profile_7_frac"
    ]
  },
  "plot_settings": {
    "3d_surface": {
      "font_sizes": {
        "axis_label": 24,
        "colorbar": 20,
        "ticks": 18
      },
      "size": [16, 10],
      "style": {
        "alpha": 0.92,
        "cmap": "flare",
        "edge_color": "black",
        "line_width": 1.2
      },
      "view": {
        "azim": 140,
        "elev": 30
      }
    },
    "general": {
      "dpi": 300
    },
    "heatmaps": {
      "font_sizes": {
        "annotations": 12,
        "colorbar": 14,
        "ticks": 12
      },
      "style": {
        "cmap": "Blues",
        "vmax": 1,
        "vmin": -1
      }
    },
    "line_plots": {
      "font_sizes": {
        "axis_label": 16,
        "legend": 12,
        "ticks": 14
      },
      "marker_size": 10,
      "markers": ["o", "s", "^", "D", "v", "*", "P", "X"],
      "size": [10, 6]
    }
  },
  "plot_thresholds": {
    "min_files_for_heatmap": 2,
    "min_values_for_line": 2,
    "min_values_for_surface": 3
  },
  "report_types": [
    "MessageStatsReport",
    "DtnmaRlMetricsReport"
  ]
}
